{
  "openapi": "3.0.3",
  "info": {
    "title": "SaveForge 2.0 GameCatalog getters",
    "version": "1.0.0",
    "description": "Local, read-only HTTP surface over the currently implemented GameCatalog getters. Every operation calls exactly one Go getter and serialises its typed result. Getters whose contract file declares 'contract definition only' are not exposed."
  },
  "servers": [
    {
      "url": "/",
      "description": "Local explorer"
    }
  ],
  "paths": {
    "/api/v1/application/info": {
      "get": {
        "operationId": "getApplicationInfo",
        "summary": "GetApplicationInfo",
        "description": "Returns the application version supplied by the backend caller, the supported GameCatalog schema version range and the capabilities the backend currently declares. Takes no query parameters.",
        "responses": {
          "200": {
            "description": "Application version, supported schemas and capabilities",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApplicationInfoResult"
                }
              }
            }
          },
          "500": {
            "description": "The backend supplied no application version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalog/info": {
      "get": {
        "operationId": "getCatalogInfo",
        "summary": "GetCatalogInfo",
        "description": "Returns the manifest of the loaded GameCatalog: schema version, data version, game version, validation status and the used sources.",
        "responses": {
          "200": {
            "description": "Catalog manifest",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCatalogInfoResult"
                }
              }
            }
          },
          "500": {
            "description": "The loaded catalog manifest is missing or invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalog/resource": {
      "get": {
        "operationId": "getResource",
        "summary": "GetResource",
        "description": "Returns one full catalog resource document. The resource identity is the exact pair (kind, key); the kind is resolved first and the key only inside that kind.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ResourceKind"
          },
          {
            "$ref": "#/components/parameters/ResourceKey"
          }
        ],
        "responses": {
          "200": {
            "description": "The resource document",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetResourceResult"
                }
              }
            }
          },
          "400": {
            "description": "kind or key is missing, or the pair is unknown. The message is the one the getter returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalog/resource-relations": {
      "get": {
        "operationId": "getResourceRelations",
        "summary": "GetResourceRelations",
        "description": "Returns the outgoing and incoming relations of one resource identified by the exact pair (kind, key), in catalog order. Relations only: the documents of the related resources belong to GetResource. A filtered-out direction stays an empty array, never null.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ResourceKind"
          },
          {
            "$ref": "#/components/parameters/ResourceKey"
          },
          {
            "$ref": "#/components/parameters/RelationType"
          },
          {
            "$ref": "#/components/parameters/RelationDirection"
          }
        ],
        "responses": {
          "200": {
            "description": "The relations of the resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetResourceRelationsResult"
                }
              }
            }
          },
          "400": {
            "description": "kind or key is missing, the pair is unknown, or relationType or direction is not supported. The message is the one the getter returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalog/resources": {
      "get": {
        "operationId": "getResources",
        "summary": "GetResources",
        "description": "Returns one page of catalog resources reduced to the fields a list or a picker needs: kind, key, family and name. Every filter is matched exactly and case-sensitively except search, which is case-insensitive on the key and on the name. An empty filter never filters. The order is the catalog order, kind first and only then key. total counts the matches before paging, and a page beyond the last one returns an empty array, never null. Full documents belong to GetResource.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ResourceTypeFilter"
          },
          {
            "$ref": "#/components/parameters/ItemFamilyFilter"
          },
          {
            "$ref": "#/components/parameters/CapabilityFilter"
          },
          {
            "$ref": "#/components/parameters/EndpointIDFilter"
          },
          {
            "$ref": "#/components/parameters/ResourceSearch"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "One page of matching resources",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetResourcesResult"
                }
              }
            }
          },
          "400": {
            "description": "page or pageSize is not an integer or is negative, resourceType, family or capability is unknown, or endpointId is set. The message is the one the getter returned, except for a non-integer page or pageSize, which the route rejects before the getter sees it.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalog/item-variants": {
      "get": {
        "operationId": "getItemVariants",
        "summary": "GetItemVariants",
        "description": "Returns the variants stored in one item document, in catalog order. An item without variants returns an empty list; the base item is never synthesised into a variant.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ResourceKind"
          },
          {
            "$ref": "#/components/parameters/ResourceKey"
          }
        ],
        "responses": {
          "200": {
            "description": "The item variants",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetItemVariantsResult"
                }
              }
            }
          },
          "400": {
            "description": "kind or key is missing, kind is not item, or the pair is unknown. The message is the one the getter returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/network/presets": {
      "get": {
        "operationId": "getNetworkPresets",
        "summary": "GetNetworkPresets",
        "description": "Returns the network parameter presets the backend offers today. An omitted or empty presetID returns every preset in the backend order; a non-empty presetID returns exactly that preset. The values come from the preset functions of backend/core. The route reads no save and no GameCatalog.",
        "parameters": [
          {
            "name": "presetID",
            "in": "query",
            "required": false,
            "description": "Public preset identifier, matched exactly and case-sensitively. It is never trimmed, normalised or resolved through an alias. Omitted or empty means every preset. The legacy core presets (fast-invasions, light-invasions, fast-summons, fast-blue, aggressive-host) are not exposed and are rejected as unknown.",
            "schema": {
              "type": "string",
              "enum": [
                "",
                "vanilla",
                "faster-reds",
                "aggressive-reds",
                "faster-summons",
                "aggressive-summons",
                "faster-blue",
                "aggressive-blue",
                "faster-summon-host",
                "aggressive-summon-host",
                "faster-summon-guest",
                "aggressive-summon-guest",
                "faster-hunter",
                "aggressive-hunter"
              ]
            },
            "example": "faster-reds"
          }
        ],
        "responses": {
          "200": {
            "description": "The requested presets with their full parameter values",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetNetworkPresetsResult"
                }
              }
            }
          },
          "400": {
            "description": "Unknown presetID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "operationId": "healthz",
        "summary": "Liveness probe",
        "responses": {
          "200": {
            "description": "The explorer is running",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  },
                  "required": ["status"]
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "openapiDocument",
        "summary": "This OpenAPI document",
        "responses": {
          "200": {
            "description": "OpenAPI 3.0 specification",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/docs": {
      "get": {
        "operationId": "docsUI",
        "summary": "Local browser explorer",
        "responses": {
          "200": {
            "description": "HTML explorer page",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "ResourceKind": {
        "name": "kind",
        "in": "query",
        "required": true,
        "description": "schema.Resource.Kind, matched exactly. The kind is resolved before the key.",
        "schema": {
          "type": "string"
        },
        "example": "item"
      },
      "ResourceKey": {
        "name": "key",
        "in": "query",
        "required": true,
        "description": "schema.Resource.Key inside the given kind, matched exactly. An item key is eight uppercase hexadecimal characters without a kind prefix. Not an Item.GameID, not a variant ID and not a data file name.",
        "schema": {
          "type": "string"
        },
        "example": "000F4240"
      },
      "RelationType": {
        "name": "relationType",
        "in": "query",
        "required": false,
        "description": "schema.RelationKind, matched exactly and case-sensitively. Omitted or empty means every relation type.",
        "schema": {
          "type": "string",
          "enum": ["", "compatible_with_aow", "requires_container"]
        },
        "example": "compatible_with_aow"
      },
      "RelationDirection": {
        "name": "direction",
        "in": "query",
        "required": false,
        "description": "Relation direction, matched exactly. Omitted or empty means both directions; there is deliberately no 'both' value. The filtered-out direction stays an empty array.",
        "schema": {
          "type": "string",
          "enum": ["", "outgoing", "incoming"]
        },
        "example": "outgoing"
      },
      "ResourceTypeFilter": {
        "name": "resourceType",
        "in": "query",
        "required": false,
        "description": "schema.Resource.Kind, matched exactly and case-sensitively. Omitted or empty means every kind. Only 'item' exists today.",
        "schema": {
          "type": "string",
          "enum": ["", "item"]
        },
        "example": "item"
      },
      "ItemFamilyFilter": {
        "name": "family",
        "in": "query",
        "required": false,
        "description": "schema.ItemFamily, matched exactly and case-sensitively. Omitted or empty means every family. A resource whose family is not known never matches.",
        "schema": {
          "type": "string",
          "enum": [
            "",
            "weapon",
            "armor",
            "talisman",
            "ash_of_war",
            "spell",
            "spirit_ash",
            "goods",
            "gesture"
          ]
        },
        "example": "weapon"
      },
      "CapabilityFilter": {
        "name": "capability",
        "in": "query",
        "required": false,
        "description": "One field of schema.ItemCapabilities. A resource matches only when that capability is both known and enabled, so undecided data never widens the result. Omitted or empty means no capability filter.",
        "schema": {
          "type": "string",
          "enum": ["", "upgrade", "infusion", "ashOfWarMount", "stack", "equipment"]
        },
        "example": "infusion"
      },
      "EndpointIDFilter": {
        "name": "endpointId",
        "in": "query",
        "required": false,
        "description": "Not supported. GameCatalog declares no resource-to-endpoint relation, so any non-empty value is rejected with 400 instead of being answered from a guessed mapping. Only the empty value is accepted.",
        "schema": {
          "type": "string",
          "enum": [""]
        }
      },
      "ResourceSearch": {
        "name": "search",
        "in": "query",
        "required": false,
        "description": "Case-insensitive substring matched against Resource.Key and the item name. An unknown name is an empty string and is never searched as a placeholder. Omitted or empty means no search.",
        "schema": {
          "type": "string"
        },
        "example": "dagger"
      },
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "description": "One-based page number. Omitted, empty or 0 means page 1. A negative value is rejected. A page beyond the last one returns an empty array with the real total.",
        "schema": {
          "type": "integer",
          "format": "int32"
        },
        "example": 1
      },
      "PageSize": {
        "name": "pageSize",
        "in": "query",
        "required": false,
        "description": "Number of entries per page. Omitted, empty or 0 means 50. A negative value is rejected. There is deliberately no maximum.",
        "schema": {
          "type": "integer",
          "format": "int32"
        },
        "example": 50
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "description": "Error envelope carrying the message returned by the getter.",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": ["error"]
      },
      "SupportedSchema": {
        "type": "object",
        "description": "One schema the backend can read and the version range it accepts for it.",
        "properties": {
          "name": {
            "type": "string"
          },
          "minimumVersion": {
            "type": "integer",
            "format": "int64"
          },
          "currentVersion": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": ["name", "minimumVersion", "currentVersion"]
      },
      "GetApplicationInfoResult": {
        "type": "object",
        "properties": {
          "applicationVersion": {
            "type": "string",
            "description": "Returned exactly as supplied by the backend caller."
          },
          "supportedSchemas": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SupportedSchema"
            }
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["applicationVersion", "supportedSchemas", "capabilities"]
      },
      "DataSource": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "reviewed": {
            "type": "boolean"
          }
        },
        "required": ["id", "kind", "location", "version", "evidence", "reviewed"]
      },
      "GetCatalogInfoResult": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "format": "int64"
          },
          "dataVersion": {
            "type": "string"
          },
          "gameVersion": {
            "type": "string"
          },
          "valid": {
            "type": "boolean",
            "description": "True only means schema.ValidateManifest accepted the manifest."
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DataSource"
            }
          }
        },
        "required": ["schemaVersion", "dataVersion", "gameVersion", "valid", "sources"]
      },
      "Resource": {
        "type": "object",
        "description": "schema.Resource identified by the (kind, key) pair. The item document is passed through as stored in the catalog; its full shape is owned by the catalog schema, not by this explorer.",
        "properties": {
          "key": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "item": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true
          }
        },
        "required": ["key", "kind", "item"]
      },
      "ItemVariant": {
        "type": "object",
        "description": "schema.ItemVariant as stored in the catalog, with full provenance.",
        "additionalProperties": true
      },
      "GetResourceResult": {
        "type": "object",
        "properties": {
          "resource": {
            "$ref": "#/components/schemas/Resource"
          }
        },
        "required": ["resource"]
      },
      "ResourceRef": {
        "type": "object",
        "description": "schema.ResourceRef: the (kind, key) pair that identifies a resource. There is no numeric resource identifier.",
        "properties": {
          "kind": {
            "type": "string",
            "example": "item"
          },
          "key": {
            "type": "string",
            "example": "000F4240"
          }
        },
        "required": ["kind", "key"]
      },
      "Relation": {
        "type": "object",
        "description": "schema.Relation as derived and stored by the catalog. Both endpoints are ResourceRef objects, never numeric IDs.",
        "properties": {
          "from": {
            "$ref": "#/components/schemas/ResourceRef"
          },
          "to": {
            "$ref": "#/components/schemas/ResourceRef"
          },
          "kind": {
            "type": "string",
            "enum": ["compatible_with_aow", "requires_container"]
          },
          "provenance": {
            "type": "object",
            "description": "The evidence the catalog derived the relation from.",
            "additionalProperties": true
          }
        },
        "required": ["from", "to", "kind", "provenance"]
      },
      "GetResourceRelationsResult": {
        "type": "object",
        "properties": {
          "outgoing": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Relation"
            }
          },
          "incoming": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Relation"
            }
          }
        },
        "required": ["outgoing", "incoming"]
      },
      "ResourceListEntry": {
        "type": "object",
        "description": "Picker-sized projection of one resource. Relations, variants, provenance, capabilities and the full item document are deliberately absent; they belong to GetResource, GetResourceRelations and GetItemVariants.",
        "properties": {
          "kind": {
            "type": "string",
            "example": "item"
          },
          "key": {
            "type": "string",
            "example": "000F4240"
          },
          "family": {
            "type": "string",
            "description": "Empty when the resource carries no item document or its family is not known.",
            "example": "weapon"
          },
          "name": {
            "type": "string",
            "description": "Empty when the item name is not known. There is no fallback to the key or to a placeholder.",
            "example": "Dagger"
          }
        },
        "required": ["kind", "key", "family", "name"]
      },
      "GetResourcesResult": {
        "type": "object",
        "properties": {
          "resources": {
            "type": "array",
            "description": "The requested page in catalog order, kind first and only then key. Empty, never null, when the page lies beyond the last one.",
            "items": {
              "$ref": "#/components/schemas/ResourceListEntry"
            }
          },
          "total": {
            "type": "integer",
            "description": "Number of resources that passed the filters, counted before paging."
          },
          "page": {
            "type": "integer",
            "description": "The effective one-based page, so a requested 0 is reported as 1."
          },
          "pageSize": {
            "type": "integer",
            "description": "The effective page size, so a requested 0 is reported as 50."
          }
        },
        "required": ["resources", "total", "page", "pageSize"]
      },
      "GetItemVariantsResult": {
        "type": "object",
        "properties": {
          "variants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemVariant"
            }
          }
        },
        "required": ["variants"]
      },
      "NetworkParamValues": {
        "type": "object",
        "description": "core.NetworkParamValues: the tunable PvP/multiplayer parameters grouped by player role. The field set and the JSON names are owned by backend/core.",
        "properties": {
          "maxBreakInTargetListCount": {
            "type": "integer",
            "format": "int32"
          },
          "breakInRequestIntervalTimeSec": {
            "type": "number",
            "format": "float"
          },
          "breakInRequestTimeOutSec": {
            "type": "number",
            "format": "float"
          },
          "breakInRequestAreaCount": {
            "type": "integer",
            "format": "int32"
          },
          "summonTimeoutTime": {
            "type": "number",
            "format": "float"
          },
          "reloadSignIntervalTime2": {
            "type": "number",
            "format": "float"
          },
          "reloadSignTotalCount": {
            "type": "integer",
            "format": "int32"
          },
          "reloadSignCellCount": {
            "type": "integer",
            "format": "int32"
          },
          "updateSignIntervalTime": {
            "type": "number",
            "format": "float"
          },
          "singGetMax": {
            "type": "integer",
            "format": "int32"
          },
          "signDownloadSpan": {
            "type": "number",
            "format": "float"
          },
          "signUpdateSpan": {
            "type": "number",
            "format": "float"
          },
          "reloadVisitListCoolTime": {
            "type": "number",
            "format": "float"
          },
          "maxCoopBlueSummonCount": {
            "type": "integer",
            "format": "int32"
          },
          "maxVisitListCount": {
            "type": "integer",
            "format": "int32"
          },
          "reloadSearchCoopBlueMin": {
            "type": "number",
            "format": "float"
          },
          "reloadSearchCoopBlueMax": {
            "type": "number",
            "format": "float"
          },
          "allAreaSearchRateCoopBlue": {
            "type": "integer",
            "format": "int32"
          },
          "allAreaSearchRateVsBlue": {
            "type": "integer",
            "format": "int32"
          },
          "visitorListMax": {
            "type": "integer",
            "format": "int32"
          },
          "visitorTimeOutTime": {
            "type": "number",
            "format": "float"
          },
          "visitorDownloadSpan": {
            "type": "number",
            "format": "float"
          }
        },
        "required": [
          "maxBreakInTargetListCount",
          "breakInRequestIntervalTimeSec",
          "breakInRequestTimeOutSec",
          "breakInRequestAreaCount",
          "summonTimeoutTime",
          "reloadSignIntervalTime2",
          "reloadSignTotalCount",
          "reloadSignCellCount",
          "updateSignIntervalTime",
          "singGetMax",
          "signDownloadSpan",
          "signUpdateSpan",
          "reloadVisitListCoolTime",
          "maxCoopBlueSummonCount",
          "maxVisitListCount",
          "reloadSearchCoopBlueMin",
          "reloadSearchCoopBlueMax",
          "allAreaSearchRateCoopBlue",
          "allAreaSearchRateVsBlue",
          "visitorListMax",
          "visitorTimeOutTime",
          "visitorDownloadSpan"
        ]
      },
      "NetworkPreset": {
        "type": "object",
        "description": "One backend preset: its stable identifier and the full parameter values it stands for.",
        "properties": {
          "id": {
            "type": "string"
          },
          "parameters": {
            "$ref": "#/components/schemas/NetworkParamValues"
          }
        },
        "required": ["id", "parameters"]
      },
      "GetNetworkPresetsResult": {
        "type": "object",
        "properties": {
          "presets": {
            "type": "array",
            "description": "Every backend preset in backend order, or exactly the one requested preset. Never null.",
            "items": {
              "$ref": "#/components/schemas/NetworkPreset"
            }
          }
        },
        "required": ["presets"]
      }
    }
  }
}
