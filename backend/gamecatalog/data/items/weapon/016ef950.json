    "presentation": {
      "name": {
        "known": true,
        "value": "Ghostflame Torch",
        "provenance": {
          "source": "game_text_weapon_name_base",
          "method": "resolved the official English WeaponName.fmg entry 24050000"
        }
      },
      "caption": {
        "known": true,
        "value": "Metal torch that burns with cold ghostflame. Tool of the Fallen Hawks who prowl the underground rivers. When the band's last embers were used up in their long search, they began to burn the bones of their fellows, acquiring the cold ghostflame, but sealing their fate as dwellers of the underground for all eternity.",
        "provenance": {
          "source": "legacy_db_data",
          "method": "copied from legacy ItemTexts.Caption"
        }
      },
      "description": {
        "known": true,
        "value": "Metal torch that burns with cold ghostflame. Tool of the Fallen Hawks who prowl the underground rivers. When the band's last embers were used up in their long search, they began to burn the bones of their fellows, acquiring the cold ghostflame, but sealing their fate as dwellers of the underground for all eternity.",
        "provenance": {
          "source": "legacy_db_data",
          "method": "copied from legacy ItemTexts.Description"
        }
      },
      "location": {
        "known": true,
        "value": "Ghostflame Torch can be found on a body at Nokron, Eternal City. To find it, you must start from the beginning of Nokron, Eternal City, entering from the Meteorite Crater. Once you get to the first set of roofs in Nokron, you will see a derelict tower off to the right of the roof ramp. You will need to jump from the ramp to the tower to reach the torch. An ideal position is to jump up onto the square platform, aim diagonally toward the corner of the tower, run and jump (holding sprint as you jump). There is no other way to reach the Ghostflame Torch if you proceed to the lower roof platforms of Nokron. There is no way back up except to start over from the Crater again. [ Map Link ] Video Location",
        "provenance": {
          "source": "legacy_db_data",
          "method": "copied from legacy ItemTexts.Location"
        }
      },
