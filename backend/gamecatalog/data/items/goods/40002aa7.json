      "caption": {
        "known": true,
        "value": "White flower that blooms in catacombs.\nA spirit nestles close to this grand specimen\n\nStrengthens renowned ashes to +10.\n\nSince times of old, large gloveworts were used to comfort heroic spirits. Given in tribute to those who died the most glorious of deaths, in the hope their stories would become legend.",
        "provenance": {
          "source": "legacy_db_data",
          "method": "copied from legacy ItemTexts.Caption"
        }
      },
      "description": {
        "known": true,
